#!/usr/bin/env bash
set -euo pipefail
shopt -u patsub_replacement 2> /dev/null || true

VERBOSE=false
DRY_RUN=false
FORCE=false
NOTIFY_SKIPS=false
pr_author=""

while [[ $# -gt 0 ]]; do
	case "$1" in
		--verbose)
			VERBOSE=true
			shift
			;;
		--dry-run)
			DRY_RUN=true
			shift
			;;
		--force)
			FORCE=true
			shift
			;;
		--notify-skips)
			NOTIFY_SKIPS=true
			shift
			;;
		--author)
			[[ $# -ge 2 ]] || {
				echo "--author needs a login" >&2
				exit 2
			}
			pr_author="$2"
			shift 2
			;;
		--)
			shift
			break
			;;
		*) break ;;
	esac
done

if [[ $# -ne 7 ]]; then
	echo "usage: stage-pr-autofix [--verbose] [--dry-run] [--force] [--notify-skips] [--author LOGIN] <owner> <repo> <number> <base_ref> <head_ref> <url> <title>" >&2
	exit 2
fi

owner="$1"
repo="$2"
pr_number="$3"
base_ref="$4"
head_ref="$5"
pr_url="$6"
pr_title="$7"

exec 200>&- || true

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/common.sh"
source "$SCRIPT_DIR/../lib/autofix.sh"

run_id="${repo}-pr${pr_number}"
key="$owner/$repo#$pr_number"
window_name="$run_id"
repo_dir="$(repo_dir_for "$repo")"
worktree="$AUTOFIX_WORKTREE_ROOT/$run_id"
run_dir="$AUTOFIX_RUNS_DIR/$run_id"
compose_project="pr-autofix-$run_id"
model="${AUTOFIX_MODEL:-sonnet}"

skip() {
	[[ "$VERBOSE" == "true" ]] || exit 0
	echo "$*" >&2
	exit 1
}

needs_you() {
	[[ "$NOTIFY_SKIPS" == "true" ]] && autofix_notify_skip "$key" "$*" "$pr_url"
	skip "$*"
}

have_commands git jq tmux claude docker || skip "needs git, jq, tmux, docker and claude on PATH"
for template in pr-autofix runtime-container runtime-none ci-dispatch ci-push; do
	[[ -f "$PROMPT_DIR/$template.txt" ]] || skip "prompt template missing: $PROMPT_DIR/$template.txt"
done

git -C "$repo_dir" rev-parse --git-dir > /dev/null 2>&1 \
	|| skip "no clone at $repo_dir (set DEV_DIR if your clones live elsewhere)"

origin_url="$(git -C "$repo_dir" remote get-url origin 2> /dev/null || true)"
case "$origin_url" in
	*"$owner/$repo" | *"$owner/$repo.git") ;;
	*) skip "origin of $repo_dir is $origin_url, not $owner/$repo" ;;
esac

autofix_clone_trusted "$repo_dir" \
	|| needs_you "Claude Code does not trust $repo_dir yet. Run claude there once and accept the trust prompt."

autofix_fetch_refs "$repo_dir" "$head_ref" "$base_ref" \
	|| skip "could not fetch $head_ref and $base_ref from origin (a fork PR cannot be resolved here)"
head_sha="$(git -C "$repo_dir" rev-parse "refs/remotes/origin/$head_ref")"
base_sha="$(git -C "$repo_dir" rev-parse "refs/remotes/origin/$base_ref")"
git_common_dir="$(cd "$repo_dir" && cd "$(git rev-parse --git-common-dir)" && pwd -P)"

local_work=""
if [[ "$(git -C "$repo_dir" symbolic-ref --short -q HEAD || true)" == "$head_ref" ]] \
	&& [[ -n "$(git -C "$repo_dir" status --porcelain --untracked-files=no)" ]]; then
	local_work="uncommitted changes on $head_ref"
fi
if git -C "$repo_dir" rev-parse -q --verify "refs/heads/$head_ref" > /dev/null; then
	ahead="$(git -C "$repo_dir" rev-list --count "refs/remotes/origin/$head_ref..refs/heads/$head_ref")"
	if ((ahead > 0)); then
		local_work="${local_work:+$local_work and }$ahead unpushed commit(s) on $head_ref"
	fi
fi
if [[ -n "$local_work" && "$FORCE" != "true" ]]; then
	needs_you "You have $local_work in $repo_dir. Push or stash it first, or stage this PR with --force."
fi

commit_prefix=""
if [[ "$head_ref" =~ ^(([A-Z]+-[0-9]+-)*[A-Z]+-[0-9]+) ]]; then
	commit_prefix="${BASH_REMATCH[1]} "
fi

ci_variant="push"
for ref in "$head_ref" "$base_ref"; do
	if git -C "$repo_dir" show "refs/remotes/origin/$ref:.github/workflows/ci.yml" 2> /dev/null | grep -q 'workflow_dispatch'; then
		ci_variant="dispatch"
	fi
done

author_note=""
if [[ -n "$pr_author" ]]; then
	author_note="This PR belongs to @$pr_author, not to the developer who started this session. Only
ever add merge commits (and fix commits, if CI needs them) on top of their work: never rebase,
amend, squash or otherwise rewrite their commits, and never touch anything the merge doesn't
require. If the push is rejected because of missing write access, record blocked.

"
fi

substitute() {
	local text="$1"
	text="${text//\{\{OWNER\}\}/$owner}"
	text="${text//\{\{REPO\}\}/$repo}"
	text="${text//\{\{PR_NUMBER\}\}/$pr_number}"
	text="${text//\{\{PR_URL\}\}/$pr_url}"
	text="${text//\{\{BASE_REF\}\}/$base_ref}"
	text="${text//\{\{HEAD_REF\}\}/$head_ref}"
	text="${text//\{\{BASE_SHA\}\}/$base_sha}"
	text="${text//\{\{HEAD_SHA\}\}/$head_sha}"
	text="${text//\{\{WORKTREE\}\}/$worktree}"
	text="${text//\{\{REPO_DIR\}\}/$repo_dir}"
	text="${text//\{\{RUN_DIR\}\}/$run_dir}"
	text="${text//\{\{COMMIT_PREFIX\}\}/$commit_prefix}"
	text="${text//\{\{STATUS_CMD\}\}/$LIBEXEC_DIR/autofix-status}"
	text="${text//\{\{PHP_CMD\}\}/$LIBEXEC_DIR/autofix-php}"
	text="${text//\{\{PR_TITLE\}\}/$pr_title}"
	printf '%s' "$text"
}

build_prompt() {
	local runtime="$1" kind runtime_note ci_note hosts stores tmpl
	kind="$(jq -r '.kind' <<< "$runtime")"

	if [[ "$kind" == "container" ]]; then
		runtime_note="$(cat "$PROMPT_DIR/runtime-container.txt")"
		hosts="$(jq -r '[.sidecars[].host] | join(", ")' <<< "$runtime")"
		if [[ -n "$hosts" ]]; then
			stores="It runs on a private network of its own, next to fresh, empty copies of the database and cache containers the app uses ($hosts), under the same hostnames and credentials, created for this run and deleted after it."
		else
			stores="It runs on a private network of its own with no database or cache containers, so tests that need one cannot run here."
		fi
		runtime_note="${runtime_note//\{\{IMAGE\}\}/$(jq -r '.image' <<< "$runtime")}"
		runtime_note="${runtime_note//\{\{APP_DIR\}\}/$(jq -r '.appDir' <<< "$runtime")}"
		runtime_note="${runtime_note//\{\{STORES\}\}/$stores}"
	else
		runtime_note="$(cat "$PROMPT_DIR/runtime-none.txt")"
		runtime_note="${runtime_note//\{\{RUNTIME_REASON\}\}/$(jq -r '.reason' <<< "$runtime")}"
	fi
	ci_note="$(cat "$PROMPT_DIR/ci-$ci_variant.txt")"

	tmpl="$(cat "$AUTOFIX_PROMPT_FILE")"
	tmpl="${tmpl//\{\{RUNTIME_NOTE\}\}/$runtime_note}"
	tmpl="${tmpl//\{\{CI_NOTE\}\}/$ci_note}"
	tmpl="${tmpl//\{\{AUTHOR_NOTE\}\}/$author_note}"
	substitute "$tmpl"
}

prepare_run_dir() {
	local wt="$1" dir="$2" runtime
	runtime="$(autofix_detect_runtime "$wt" "$dir" "$run_id")"
	jq -n \
		--arg key "$key" --arg owner "$owner" --arg repo "$repo" --argjson number "$pr_number" \
		--arg url "$pr_url" --arg title "$pr_title" --arg author "$pr_author" \
		--arg headRef "$head_ref" --arg baseRef "$base_ref" --arg headSha "$head_sha" --arg baseSha "$base_sha" \
		--arg repoDir "$repo_dir" --arg worktree "$worktree" --arg gitCommonDir "$git_common_dir" \
		--arg runDir "$run_dir" --arg runId "$run_id" --arg windowName "$window_name" \
		--arg sessionName "$repo#$pr_number" --arg model "$model" --arg composeProject "$compose_project" \
		--arg ci "$ci_variant" --argjson runtime "$runtime" \
		'{key: $key, owner: $owner, repo: $repo, number: $number, url: $url, title: $title, author: $author,
		  headRef: $headRef, baseRef: $baseRef, headSha: $headSha, baseSha: $baseSha,
		  repoDir: $repoDir, worktree: $worktree, gitCommonDir: $gitCommonDir, runDir: $runDir, runId: $runId,
		  windowName: $windowName, sessionName: $sessionName, model: $model, composeProject: $composeProject,
		  ci: $ci, runtime: $runtime}' > "$dir/run.json"
	build_prompt "$runtime" > "$dir/prompt.txt"
	autofix_write_settings "$dir" "$repo_dir" "$compose_project" "$(jq -r '.kind' <<< "$runtime")"
}

if [[ "$DRY_RUN" == "true" ]]; then
	scratch="$(mktemp -d)"
	trap 'git -C "$repo_dir" worktree remove --force "$scratch/wt" > /dev/null 2>&1 || true; git -C "$repo_dir" worktree prune > /dev/null 2>&1 || true; rm -rf "$scratch"' EXIT
	mkdir -p "$scratch/run"
	git -C "$repo_dir" worktree add --detach --quiet "$scratch/wt" "refs/remotes/origin/$head_ref"
	autofix_copy_ignored_files "$repo_dir" "$scratch/wt"
	prepare_run_dir "$scratch/wt" "$scratch/run"
	printf 'Would stage %s in %s:%s\n  worktree: %s\n  run dir:  %s\n  local work: %s\n\n' \
		"$key" "$TMUX_SESSION" "$window_name" "$worktree" "$run_dir" "${local_work:-none}"
	printf '== runtime\n'
	jq '.runtime' "$scratch/run/run.json"
	printf '\n== settings.json\n'
	jq . "$scratch/run/settings.json"
	printf '\n== prompt\n'
	cat "$scratch/run/prompt.txt"
	printf '\n'
	exit 0
fi

autofix_lock 10 || skip "another PR session is being staged right now"
autofix_reap_locked

existing="$(autofix_run_json "$key")"
[[ -z "$existing" ]] || skip "a session for $key is already running in $TMUX_SESSION:$(jq -r '.windowName' <<< "$existing")"
autofix_window_exists "$window_name" \
	&& needs_you "The tmux window $TMUX_SESSION:$window_name already exists. Close it, then the PR gets a new session."
[[ ! -e "$worktree" ]] \
	|| needs_you "A worktree from an earlier session is still at $worktree. Inspect it, then: git -C $repo_dir worktree remove --force $worktree"

active="$(jq 'length' "$AUTOFIX_RUNS_FILE" 2> /dev/null || echo 0)"
((active < AUTOFIX_MAX_RUNS)) || skip "$active sessions are already running (AUTOFIX_MAX_RUNS=$AUTOFIX_MAX_RUNS)"

below="$(jq -r --arg owner "$owner" --arg repo "$repo" --arg base "$base_ref" \
	'[.[] | select(.owner == $owner and .repo == $repo and .headRef == $base) | .number][0] // empty' "$AUTOFIX_RUNS_FILE")"
[[ -z "$below" ]] || skip "waiting for the session on PR #$below, which this PR is stacked on"

recorded=false
launched=false
abort_staging() {
	[[ "$recorded" == "true" && "$launched" != "true" ]] || return 0
	autofix_remove_containers "$run_id"
	autofix_remove_worktree "$repo_dir" "$worktree" || true
	autofix_drop_run "$key"
}
trap abort_staging EXIT

json_update "$AUTOFIX_RUNS_FILE" \
	--arg k "$key" --arg owner "$owner" --arg repo "$repo" --argjson number "$pr_number" --arg url "$pr_url" \
	--arg headRef "$head_ref" --arg baseRef "$base_ref" --arg baseSha "$base_sha" \
	--arg repoDir "$repo_dir" --arg worktree "$worktree" --arg runDir "$run_dir" --arg runId "$run_id" \
	--arg windowName "$window_name" --arg startedAt "$(date -u +%FT%TZ)" --argjson startedEpoch "$(date +%s)" \
	'.[$k] = {owner: $owner, repo: $repo, number: $number, url: $url, headRef: $headRef, baseRef: $baseRef,
	          baseSha: $baseSha, repoDir: $repoDir, worktree: $worktree, runDir: $runDir, runId: $runId,
	          windowName: $windowName, phase: "staging", startedAt: $startedAt, startedEpoch: $startedEpoch}'
recorded=true

rm -rf "$run_dir"
mkdir -p "$run_dir" "$AUTOFIX_WORKTREE_ROOT" "$AUTOFIX_CACHE_DIR/composer"
git -C "$repo_dir" worktree prune > /dev/null 2>&1 || true
git -C "$repo_dir" worktree add --detach --quiet "$worktree" "refs/remotes/origin/$head_ref" \
	|| skip "git worktree add failed for $worktree"
autofix_copy_ignored_files "$repo_dir" "$worktree"
prepare_run_dir "$worktree" "$run_dir"

if [[ "$(jq -r '.runtime.kind' "$run_dir/run.json")" == "container" ]]; then
	autofix_start_sidecars "$run_dir" || skip "could not start the throwaway containers for $key"
fi

session_cmd="$(printf '%q %q' "$LIBEXEC_DIR/autofix-session" "$run_dir")"
if tmux has-session -t "$TMUX_SESSION" 2> /dev/null; then
	window_id="$(tmux new-window -d -P -F '#{window_id}' -t "$TMUX_SESSION:" -n "$window_name" -c "$worktree" "$session_cmd" 200>&- 201>&-)" \
		|| skip "could not open a tmux window in $TMUX_SESSION"
else
	window_id="$(tmux new-session -d -P -F '#{window_id}' -s "$TMUX_SESSION" -n "$window_name" -c "$worktree" "$session_cmd" 200>&- 201>&-)" \
		|| skip "could not start the $TMUX_SESSION tmux session"
fi

json_update "$AUTOFIX_RUNS_FILE" --arg k "$key" --arg id "$window_id" '.[$k].windowId = $id | .[$k].phase = "launched"'
launched=true
autofix_clear_skip "$key"
autofix_unlock

attach="tmux attach -t $TMUX_SESSION:$window_name"
for _ in $(seq 1 90); do
	[[ -f "$run_dir/status.json" ]] && break
	autofix_window_alive "$window_id" || break
	sleep 1
done

if [[ ! -f "$run_dir/status.json" ]]; then
	if autofix_window_alive "$window_id"; then
		tmux capture-pane -p -t "$window_id" > "$run_dir/pane.txt" 2> /dev/null || true
		autofix_notify "PR $repo#$pr_number needs you" "Its session has not started work after 90 s; something on screen is waiting.
$attach" "$pr_url"
		skip "the session in $TMUX_SESSION:$window_name has not started work after 90 s; see $run_dir/pane.txt or $attach"
	fi
	skip "claude exited right after starting in $TMUX_SESSION:$window_name; the next reap cleans up"
fi

if [[ "$VERBOSE" == "true" ]]; then
	printf 'Started %s in %s:%s\n  worktree: %s\n  run dir:  %s\n  attach:   %s\n' \
		"$key" "$TMUX_SESSION" "$window_name" "$worktree" "$run_dir" "$attach"
fi
exit 0
