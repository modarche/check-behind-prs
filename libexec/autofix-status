#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/common.sh"
source "$SCRIPT_DIR/../lib/autofix.sh"

usage() {
	echo "usage: autofix-status <working|waiting-ci|done|blocked|failed> <message> [url]" >&2
	exit 2
}

state="${1:-}"
message="${2:-}"
url="${3:-}"
case "$state" in
	working | waiting-ci | done | blocked | failed) ;;
	*) usage ;;
esac
[[ -n "$message" ]] || usage

run_dir="${PR_AUTOFIX_RUN_DIR:-}"
if [[ -z "$run_dir" || ! -f "$run_dir/run.json" ]]; then
	echo "autofix-status: PR_AUTOFIX_RUN_DIR does not point at a run directory" >&2
	exit 2
fi

autofix_write_status "$run_dir" "$state" "$message" "$url"

eval "$(jq -r '@sh "label=\(.sessionName) window_name=\(.windowName) pr_url=\(.url)"' "$run_dir/run.json")"
case "$state" in
	blocked | failed)
		autofix_notify "PR $label: $state" "$message
tmux attach -t $TMUX_SESSION:$window_name" "$pr_url"
		;;
	done)
		autofix_notify "PR $label: done" "$message" "$pr_url" 8000
		;;
esac

echo "Recorded $state."
